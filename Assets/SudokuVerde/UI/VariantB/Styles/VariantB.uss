/* Sudoku Verde — Variant B Stylesheet (Reference: 1080 x 1920, Safe Area + Crisp Icons) */

.sv-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    color: #231F20;
}

.sv-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 112px 43px 67px 43px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.sv-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 112px 43px 67px 43px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity, scale;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.sv-level-selector {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 653px;
    height: 130px;
    min-height: 130px;
    flex-shrink: 0;
    padding: 0 18px;
    margin-bottom: 24px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
}

.sv-level-btn {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    background-color: #69B34C;
    color: #FFFFFF;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 24px;
    padding: 0;
    margin: 0;
}

.sv-level-btn:hover {
    scale: 1.05 1.05;
}

.sv-level-btn:active {
    scale: 0.93 0.93;
}

.sv-level-label {
    flex-grow: 1;
    font-size: 56px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.sv-btn-icon--red {
    background-color: #D94848;
    border-color: #A62B2B;
    border-radius: 34px;
}

.sv-btn-icon--red .vb-glyph-close {
    -unity-background-image-tint-color: #FFFFFF;
}

.is-hidden {
    display: none;
    opacity: 0;
}

/* Backgrounds */
.bg-gradient {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/background_gradient.png");
    background-size: cover;
    background-position: center;
}

.bg-gameplay {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/background_gameplay.png");
    background-size: cover;
    background-position: center;
}

.bg-overlay-dark {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_overlay_dark.png");
    background-color: rgba(18, 28, 12, 0.72);
    background-size: cover;
    background-position: center;
}

/* Reusable Buttons */
.vb-btn-square {
    width: 125px;
    height: 125px;
    flex-shrink: 0;
    padding: 22px;
    margin: 0;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 34px;
    background-color: #EEF6C5;
    align-items: center;
    justify-content: center;
    transition-property: scale, rotate;
    transition-duration: 120ms;
}

.vb-btn-square:hover {
    scale: 1.04 1.04;
}

.vb-btn-square:active {
    scale: 0.93 0.93;
}

.vb-glyph-close {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_close.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-glyph-back {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_back.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: #69B34C;
}

.vb-glyph-hint {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_hint.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.sv-btn-wide {
    width: 653px;
    height: 130px;
    min-height: 130px;
    flex-shrink: 0;
    flex-shrink: 0;
    padding: 0 38px;
    margin: 17px 0;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    background-color: #EEF6C5;
    font-size: 53px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    transition-property: scale, rotate;
    transition-duration: 120ms;
}

.sv-btn-wide:hover {
    scale: 1.03 1.03;
}

.sv-btn-wide:active {
    scale: 0.95 0.95;
}

/* Main Menu B */
.vb-menu-level-banner {
    width: 643px;
    height: 139px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.vb-menu-level-text {
    font-size: 72px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.vb-menu-illustration {
    width: 686px;
    height: 547px;
    margin-top: 43px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/illustration_garden.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-menu-title {
    margin-top: 14px;
    font-size: 110px;
    -unity-font-style: bold;
    color: #367B28;
    -unity-text-align: middle-center;
    white-space: normal;
}

.vb-menu-actions {
    margin-top: 67px;
    align-items: center;
    justify-content: center;
}

/* Gameplay B */
.vb-top-bar {
    width: 100%;
    max-width: 874px;
    margin-bottom: 19px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.vb-hint-wrap {
    position: relative;
    width: 125px;
    height: 125px;
    flex-shrink: 0;
}

.vb-hint-badge {
    position: absolute;
    left: -29px;
    top: -19px;
    width: 72px;
    height: 72px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/badge_base.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    align-items: center;
    justify-content: center;
}

.vb-hint-badge__text {
    font-size: 38px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.vb-level-tab {
    height: 115px;
    flex-grow: 1;
    margin: 0 24px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.vb-level-tab__text {
    font-size: 58px;
    -unity-font-style: bold;
    color: #367B28;
    -unity-text-align: middle-center;
}

.vb-gameplay-center {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: center;
}

.plant-progress-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 12px 38px;
    margin-bottom: 24px;
    background-color: #EEF6C5;
    border-width: 7px;
    border-color: #69B34C;
    border-radius: 38px;
}

.plant-progress-icon {
    width: 58px;
    height: 67px;
    margin-right: 19px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.plant-progress-text {
    font-size: 48px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.vb-board-frame {
    width: 854px;
    height: 854px;
    padding: 29px;
    background-color: #EEF6C5;
    border-width: 12px;
    border-color: #69B34C;
    border-radius: 53px;
    align-items: center;
    justify-content: center;
}

.board-grid {
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: space-between;
    justify-content: space-between;
}

.board-cell {
    width: 22.5%;
    height: 22.5%;
    margin: 1.25%;
    padding: 14px;
    border-width: 0;
    border-radius: 29px;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 90ms;
}

.board-cell:hover {
    scale: 1.03 1.03;
}

.board-cell:active {
    scale: 0.92 0.92;
}

.cell--orange {
    background-color: #F4A259;
}

.cell--blue {
    background-color: #82B3E2;
}

.cell--green {
    background-color: #6BBF47;
}

.cell--light-green {
    background-color: #A9D46D;
}

.cell--player-plant {
    border-width: 7px;
    border-color: #FFFFFF;
}

.cell--hinted {
    border-width: 10px;
    border-color: #FFD600;
}

.cell--conflict {
    border-width: 10px;
    border-color: #D9362B;
}

.cell-icon-plant {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.cell-icon-cross {
    width: 90%;
    height: 90%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_cross.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

/* Permanent Bottom Rules Row */
.vb-rules-row {
    width: 100%;
    margin-top: 29px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.vb-rule-card {
    width: 32%;
    height: 403px;
    padding: 19px 14px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.vb-rule-diagram {
    width: 226px;
    height: 216px;
    margin-bottom: 14px;
    flex-shrink: 0;
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-rule-color {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_rule_color.png");
}

.vb-rule-rowcol {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_rule_row_column.png");
}

.vb-rule-adj {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_rule_adjacency.png");
}

.vb-rule-text {
    font-size: 31px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Instructions Overlay B */
.vb-instructions-content {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: center;
}

.vb-instr-card {
    width: 100%;
    min-height: 298px;
    margin: 29px 0;
    padding: 29px 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #EEF6C5;
    border-width: 12px;
    border-color: #69B34C;
    border-radius: 53px;
}

.vb-instr-tile {
    width: 211px;
    height: 211px;
    flex-shrink: 0;
    padding: 24px;
    background-color: #6BBF47;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
    margin-right: 29px;
}

.vb-instr-icon-plant {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-instr-icon-cross {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_cross_large.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-instr-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 46px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Settings B */
.vb-settings-banner {
    width: 100%;
    max-width: 768px;
    height: 130px;
    margin-top: 19px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.vb-settings-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.vb-settings-list {
    flex-grow: 1;
    width: 100%;
    max-width: 816px;
    align-items: center;
    justify-content: center;
}

.vb-settings-block {
    width: 100%;
    align-items: center;
    margin: 38px 0;
}

.vb-settings-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 19px;
}

.vb-settings-icon {
    width: 86px;
    height: 86px;
    margin-right: 24px;
    flex-shrink: 0;
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-icon-music {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_music.png");
}

.vb-icon-vibration {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_vibration.png");
}

.vb-settings-row-label {
    font-size: 53px;
    -unity-font-style: bold;
    color: #231F20;
}

.vb-settings-variant-caption {
    font-size: 48px;
    -unity-font-style: bold;
    color: #231F20;
    margin-bottom: 19px;
    -unity-text-align: middle-center;
}

.vb-seg-toggle {
    width: 682px;
    height: 125px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    background-color: #D2DFB6;
    transition-property: scale;
    transition-duration: 90ms;
}

.vb-seg-toggle:active {
    scale: 0.96 0.96;
}

.vb-seg-toggle--off {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_toggle_off_base.png");
    background-size: 100% 100%;
    border-width: 0;
    background-color: transparent;
}

.vb-seg-toggle--on {
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_toggle_on_base.png");
    background-size: 100% 100%;
    border-width: 0;
    background-color: transparent;
}

.vb-seg-toggle > .unity-toggle__input {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
}

.vb-seg-option {
    width: 50%;
    font-size: 38px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

/* Pause Overlay B */
.pause-backdrop {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.pause-card {
    width: 806px;
    padding: 58px 48px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 58px;
    align-items: center;
}

.pause-title {
    font-size: 62px;
    -unity-font-style: bold;
    color: #231F20;
    margin-bottom: 34px;
    -unity-text-align: middle-center;
}

/* Victory Overlay B */
.vb-victory-content {
    flex-grow: 1;
    width: 100%;
    max-width: 854px;
    align-items: center;
    justify-content: center;
}

.vb-victory-panel {
    width: 100%;
    height: 720px;
    background-color: #EEF6C5;
    border-width: 12px;
    border-color: #69B34C;
    border-radius: 62px;
    align-items: center;
    justify-content: center;
    padding: 38px;
    margin-bottom: 53px;
}

.vb-victory-title {
    font-size: 86px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    margin-bottom: 19px;
}

.vb-victory-art {
    width: 504px;
    height: 456px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.victory-sparkles {
    position: absolute;
    width: 480px;
    height: 451px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/sparkles_victory.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    transition-property: scale;
    transition-duration: 360ms;
}

.victory-plant {
    width: 250px;
    height: 331px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant_victory.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    transition-property: scale;
    transition-duration: 300ms;
}

.victory-celebrate {
    scale: 1.08 1.08;
}

.vb-victory-actions {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.vb-victory-action-btn {
    width: 355px;
    height: 355px;
    padding: 58px;
    margin: 0;
    border-width: 12px;
    border-color: #69B34C;
    border-radius: 62px;
    background-color: #EEF6C5;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 90ms;
}

.vb-victory-action-btn:hover {
    scale: 1.04 1.04;
}

.vb-victory-action-btn:active {
    scale: 0.94 0.94;
}

.vb-victory-icon-restart {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_restart.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.vb-victory-icon-next {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/SudokuVerde_VariantB_Complemento/PNG/variant_b_icon_next.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

/* Idle nudge animations */
.nudge-left {
    scale: 1.14 1.14;
    rotate: -10deg;
}

.nudge-right {
    scale: 1.14 1.14;
    rotate: 10deg;
}
