/* Sudoku Verde — Variant A Stylesheet (Reference: 1080 x 1920, Safe Area + Crisp Icons) */

.sv-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    color: #231F20;
}

.sv-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 112px 43px 67px 43px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.sv-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 112px 43px 67px 43px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity, scale;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.sv-level-selector {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 653px;
    height: 130px;
    min-height: 130px;
    flex-shrink: 0;
    padding: 0 18px;
    margin-bottom: 24px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
}

.sv-level-btn {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    background-color: #69B34C;
    color: #FFFFFF;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 24px;
    padding: 0;
    margin: 0;
}

.sv-level-btn:hover {
    scale: 1.05 1.05;
}

.sv-level-btn:active {
    scale: 0.93 0.93;
}

.sv-level-label {
    flex-grow: 1;
    font-size: 56px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.sv-btn-icon--red {
    background-image: none;
    background-color: #D94848;
    border-width: 8px;
    border-color: #A62B2B;
    border-radius: 28px;
}

.sv-btn-icon--red .sv-btn-icon__glyph {
    -unity-background-image-tint-color: #FFFFFF;
}

.is-hidden {
    display: none;
    opacity: 0;
}

/* Backgrounds */
.bg-gradient {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/background_gradient.png");
    background-size: cover;
    background-position: center;
}

.bg-gameplay {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/background_gameplay.png");
    background-size: cover;
    background-position: center;
}

.bg-overlay-green {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/overlay_green.png");
    background-color: rgba(84, 138, 36, 0.72);
    background-size: cover;
    background-position: center;
}

/* Reusable Buttons */
.sv-btn-icon {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    padding: 19px;
    margin: 0;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/button_icon_base.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    align-items: center;
    justify-content: center;
    transition-property: scale, rotate;
    transition-duration: 120ms;
}

.sv-btn-icon:hover {
    scale: 1.04 1.04;
}

.sv-btn-icon:active {
    scale: 0.93 0.93;
}

.sv-btn-icon__glyph {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.glyph-settings {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_settings.png");
}

.glyph-back {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_back.png");
}

.glyph-help {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_help.png");
}

.glyph-close {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_close.png");
}

.sv-btn-wide {
    width: 653px;
    height: 130px;
    min-height: 130px;
    flex-shrink: 0;
    flex-shrink: 0;
    padding: 0 38px;
    margin: 17px 0;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    background-color: #EEF6C5;
    font-size: 53px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    transition-property: scale, rotate;
    transition-duration: 120ms;
}

.sv-btn-wide:hover {
    scale: 1.03 1.03;
}

.sv-btn-wide:active {
    scale: 0.95 0.95;
}

/* Header */
.sv-header {
    width: 100%;
    max-width: 874px;
    height: 134px;
    margin-bottom: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.sv-header__banner {
    height: 120px;
    flex-grow: 1;
    margin: 0 24px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.sv-header__banner--settings {
    background-color: #EEF6C5;
}

.sv-header__title {
    font-size: 55px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.sv-header__spacer {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
}

/* Main Menu */
.menu-top-bar {
    width: 100%;
    max-width: 874px;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.menu-illustration {
    width: 672px;
    height: 528px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/illustration_garden.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.menu-title {
    margin-top: 10px;
    font-size: 110px;
    -unity-font-style: bold;
    color: #367B28;
    -unity-text-align: middle-center;
    white-space: normal;
}

.menu-streak-caption {
    margin-top: 38px;
    font-size: 38px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.menu-streak-pill {
    width: 490px;
    height: 106px;
    margin-top: 10px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 34px;
    align-items: center;
    justify-content: center;
}

.menu-streak-value {
    font-size: 53px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.menu-actions {
    margin-top: 77px;
    align-items: center;
    justify-content: center;
}

/* Gameplay */
.gameplay-content {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: center;
}

.plant-progress-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 12px 38px;
    margin-bottom: 24px;
    background-color: #EEF6C5;
    border-width: 7px;
    border-color: #69B34C;
    border-radius: 38px;
}

.plant-progress-icon {
    width: 58px;
    height: 67px;
    margin-right: 19px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.plant-progress-text {
    font-size: 48px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.board-frame {
    width: 854px;
    height: 854px;
    padding: 29px;
    background-color: #EEF6C5;
    border-width: 12px;
    border-color: #69B34C;
    border-radius: 53px;
    align-items: center;
    justify-content: center;
}

.board-grid {
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: space-between;
    justify-content: space-between;
}

.board-cell {
    width: 22.5%;
    height: 22.5%;
    margin: 1.25%;
    padding: 19px;
    border-width: 0;
    border-radius: 34px;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 90ms;
}

.board-cell:hover {
    scale: 1.03 1.03;
}

.board-cell:active {
    scale: 0.92 0.92;
}

.cell--orange {
    background-color: #F4A259;
}

.cell--blue {
    background-color: #82B3E2;
}

.cell--green {
    background-color: #6BBF47;
}

.cell--light-green {
    background-color: #A9D46D;
}

.cell--player-plant {
    border-width: 7px;
    border-color: #FFFFFF;
}

.cell--hinted {
    border-width: 10px;
    border-color: #FFD600;
}

.cell--conflict {
    border-width: 10px;
    border-color: #D9362B;
}

.cell-icon-plant {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.cell-icon-cross {
    width: 90%;
    height: 90%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_cross.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.gameplay-bottom-bar {
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    margin-top: 53px;
}

.action-slot {
    align-items: center;
    margin: 0 24px;
}

.action-btn-wrap {
    position: relative;
    width: 197px;
    height: 187px;
}

.sv-btn-action {
    width: 197px;
    height: 187px;
    padding: 29px;
    margin: 0;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 43px;
    background-color: #EEF6C5;
    align-items: center;
    justify-content: center;
    transition-property: scale, rotate;
    transition-duration: 120ms;
}

.sv-btn-action:hover {
    scale: 1.04 1.04;
}

.sv-btn-action:active {
    scale: 0.94 0.94;
}

.tool-btn--active {
    border-width: 10px;
    border-color: #2E7D32;
    background-color: #D7F09F;
}

.action-icon-plant {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.action-icon-cross {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_cross.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: #367B28;
}

.action-icon-hint {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_hint.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.nudge-left {
    scale: 1.14 1.14;
    rotate: -10deg;
}

.nudge-right {
    scale: 1.14 1.14;
    rotate: 10deg;
}

.action-badge {
    position: absolute;
    right: -24px;
    top: -24px;
    width: 82px;
    height: 82px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/badge_base.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    align-items: center;
    justify-content: center;
}

.action-badge__text {
    font-size: 43px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.action-caption {
    margin-top: 14px;
    padding: 7px 19px;
    border-radius: 24px;
    background-color: rgba(238, 246, 197, 0.92);
    border-width: 5px;
    border-color: #69B34C;
    font-size: 29px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

/* Settings */
.settings-content {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: center;
}

.settings-group {
    align-items: center;
    margin: 34px 0;
}

.settings-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: #231F20;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.settings-toggle {
    width: 653px;
    height: 130px;
    min-height: 130px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 90ms;
}

.settings-toggle:hover {
    scale: 1.03 1.03;
}

.settings-toggle:active {
    scale: 0.95 0.95;
}

.settings-toggle > .unity-toggle__input {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
}

.settings-toggle__text {
    font-size: 53px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

/* Pause Overlay */
.pause-backdrop {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.pause-card {
    width: 806px;
    padding: 58px 48px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 58px;
    align-items: center;
}

.pause-title {
    font-size: 62px;
    -unity-font-style: bold;
    color: #231F20;
    margin-bottom: 34px;
    -unity-text-align: middle-center;
}

/* Tutorial Overlay */
.tutorial-content {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: space-evenly;
}

.tutorial-item {
    align-items: center;
    width: 100%;
}

.tutorial-diagram {
    width: 259px;
    height: 240px;
    margin-bottom: 19px;
    flex-shrink: 0;
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
}

.diagram-color {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/tutorial_color.png");
}

.diagram-row-col {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/tutorial_row_column.png");
}

.diagram-adjacency {
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/tutorial_adjacency.png");
}

.tutorial-panel-short {
    width: 658px;
    min-height: 120px;
    padding: 19px 38px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.tutorial-panel-medium {
    width: 667px;
    min-height: 182px;
    padding: 19px 38px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.tutorial-panel-large {
    width: 744px;
    min-height: 197px;
    padding: 19px 43px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.tutorial-text {
    font-size: 46px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Victory Overlay */
.victory-top-bar {
    width: 100%;
    max-width: 874px;
    flex-direction: row;
    justify-content: flex-start;
    margin-bottom: 19px;
}

.victory-content {
    flex-grow: 1;
    width: 100%;
    max-width: 874px;
    align-items: center;
    justify-content: center;
}

.victory-title-panel {
    width: 754px;
    height: 202px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 53px;
    align-items: center;
    justify-content: center;
    margin-bottom: 43px;
}

.victory-title-text {
    font-size: 62px;
    -unity-font-style: bold;
    color: #231F20;
    -unity-text-align: middle-center;
}

.victory-reward-panel {
    width: 754px;
    height: 552px;
    background-color: #EEF6C5;
    border-width: 10px;
    border-color: #69B34C;
    border-radius: 58px;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 48px;
}

.victory-sparkles {
    position: absolute;
    width: 480px;
    height: 456px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/sparkles_victory.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    transition-property: scale;
    transition-duration: 360ms;
}

.victory-plant {
    width: 259px;
    height: 336px;
    background-image: url("project://database/Assets/SudokuVerde_Assets/PNG/icon_plant_victory.png");
    background-size: contain;
    flex-shrink: 0;    background-repeat: no-repeat;
    background-position: center;
    transition-property: scale;
    transition-duration: 300ms;
}

.victory-celebrate {
    scale: 1.08 1.08;
}
